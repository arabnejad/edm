Output docs/assets/edm-demo.gif

Require edm

Set Shell bash
Set Width 1600
Set Height 900
Set FontSize 14
Set Framerate 25
Set LineHeight 1.1
Set TypingSpeed 120ms
Set PlaybackSpeed 0.5
Set WaitTimeout 20s

# Start with a short, predictable prompt.
Hide
Type "export PS1='$ '"
Enter
Type "clear"
Enter
Show
